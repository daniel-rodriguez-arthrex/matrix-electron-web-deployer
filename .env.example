# Matrix Electron Web Deployer configuration
# Copy to .env and fill in values

ROUTER_IP=<your-router-ip>
SSH_USERNAME=<your-ssh-username>

# Shared credentials for all OR rooms
SSH_PASSWORD=
SUDO_PASSWORD=

# Optional: override source repo locations (defaults to ../repos/*)
# BACKEND_REPO=C:\path\to\matrix-api-linux
# WEB_REPO=C:\path\to\matrix-app-linux
